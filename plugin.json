    "name": "Joel Taroreh",
    "url": "https://github.com/jtaroreh/agystack"
  },
  "homepage": "https://github.com/semantic-craft/agystack",
  "repository": "https://github.com/semantic-craft/agystack",
  "license": "MIT",
  "logo": "assets/logo.png",
  "keywords": [
    "agystack",
    "pstack",
    "poteto-mode",
    "workflow",
    "principles",
    "agent-style",
    "subagents",
    "unslop",
    "deslop"
  ],
  "suggestedPrompts": [
    "/agystack plan and implement this feature",
